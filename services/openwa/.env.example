# Puerto del microservicio
PORT=3100

# Nombre de la sesión (crea una carpeta de sesión persistente con este nombre)
WA_SESSION=atlas-sales

# Token opcional para proteger la API. Si lo definís acá, tenés que setear
# el mismo valor en el CRM como VITE_OPENWA_TOKEN.
AUTH_TOKEN=

# Origen permitido para CORS (el CRM en desarrollo corre en :8080)
CORS_ORIGIN=http://localhost:8080
