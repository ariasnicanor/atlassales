# ── Proveedor de WhatsApp ──────────────────────────────────────
# mock      → conversaciones simuladas (default; el demo funciona sin backend)
# openwa    → microservicio Node con @open-wa/wa-automate (ver services/openwa)
# cloud-api → WhatsApp Cloud API oficial de Meta (backend en Supabase)
VITE_WA_PROVIDER=mock

# URL del microservicio OpenWA (solo si VITE_WA_PROVIDER=openwa)
VITE_OPENWA_URL=http://localhost:3100

# Token para autenticar contra el microservicio OpenWA (opcional; debe
# coincidir con AUTH_TOKEN de services/openwa/.env)
# VITE_OPENWA_TOKEN=

# ── Cloud API (solo si VITE_WA_PROVIDER=cloud-api) ─────────────
# Backend en Supabase (tablas wa_chats/wa_messages + Edge Functions
# wa-webhook y wa-send). La anon key es pública por diseño.
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
# VITE_WA_SEND_URL=https://<ref>.supabase.co/functions/v1/wa-send
# VITE_WA_SEND_SECRET=<shared secret; igual que APP_SEND_SECRET en Supabase>
